import bpy
for a in bpy.context.screen.areas:
    if a.type == "VIEW_3D":
        for r in a.regions:
            if r.type == "WINDOW":
                with bpy.context.temp_override(area=a, region=r):
                    for o in bpy.data.collections["Cab_Controls"].objects: o.select_set(True)
                    bpy.ops.view3d.view_selected()
